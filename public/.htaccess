# Redirect www to non-www with permanent 301
# Place this file in the project's `public/` folder (public/.htaccess) if your hosting uses Apache
# This forces www.example.com/* -> https://example.com/*

RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Optional: force HTTPS (if not already handled by hosting)
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
